{
  "name": "quant_domain",
  "category": "misc",
  "description": "Generic quantization: n_bits, scheme. Metrics: sqnr, compression.",
  "simulator": "quant_domain_simulate",
  "params": [
    {"name": "n_bits", "type": "int", "range": [2, 8]},
    {"name": "scheme", "type": "choice", "values": ["symmetric", "asymmetric"]}
  ],
  "behavioral_dims": [["sqnr", 10, 0.0, 60.0], ["compression", 10, 2.0, 8.0]],
  "scoring": {
    "components": [
      {"metric": "sqnr", "weight": 1.0},
      {"metric": "compression", "weight": 3.0}
    ],
    "hardening": ["no_nan"]
  }
}
