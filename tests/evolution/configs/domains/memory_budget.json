{
  "name": "memory_budget",
  "category": "memory",
  "description": "VRAM budget allocation: kv, weight, activation, reserve fractions.",
  "simulator": "memory_budget_simulate",
  "params": [
    {"name": "kv_budget", "type": "float", "range": [0.2, 0.8]},
    {"name": "weight_budget", "type": "float", "range": [0.1, 0.5]},
    {"name": "activation_budget", "type": "float", "range": [0.1, 0.3]},
    {"name": "reserve", "type": "float", "range": [0.05, 0.2]}
  ],
  "behavioral_dims": [["utilization", 10, 0.0, 1.0], ["oom_risk", 10, 0.0, 5.0]],
  "scoring": {
    "components": [
      {"metric": "utilization", "weight": 8.0},
      {"metric": "oom_risk", "weight": -1.0},
      {"metric": "wt_penalty", "weight": -1.0}
    ],
    "hardening": ["no_nan"]
  }
}
