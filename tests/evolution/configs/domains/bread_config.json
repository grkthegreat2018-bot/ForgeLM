{
  "name": "bread_config",
  "category": "training",
  "description": "BREAD landscape correction for BAdam: correction_mode, sgd_lr_scale. Metrics: mode_bonus, lr_scale_quality, stability.",
  "simulator": "bread_simulate",
  "params": [
    {"name": "correction_mode", "type": "choice", "values": ["disabled", "partial", "all"]},
    {"name": "sgd_lr_scale", "type": "float", "range": [1.0, 10.0]}
  ],
  "behavioral_dims": [["correction_quality", 10, 0, 1], ["stability", 10, 0, 1]],
  "scoring": {
    "components": [
      {"metric": "mode_bonus", "weight": 1.0},
      {"metric": "lr_scale_quality", "weight": 1.0}
    ],
    "penalties": [],
    "hardening": ["no_nan"]
  }
}
