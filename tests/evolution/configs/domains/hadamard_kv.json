{
  "name": "hadamard_kv",
  "category": "kv",
  "description": "Apply Hadamard transform to K,V. Search hadamard_dim, n_apply, quant_bits.",
  "simulator": "hadamard_kv_simulate",
  "params": [
    {"name": "hadamard_dim", "type": "int", "range": [64, 512]},
    {"name": "n_apply", "type": "int", "range": [1, 4]},
    {"name": "quant_bits", "type": "choice", "values": [4, 8]}
  ],
  "behavioral_dims": [["err_reduction", 10, 0.0, 0.3], ["compute_cost", 10, 0.0, 16.0]],
  "scoring": {
    "components": [
      {"metric": "err_reduction", "weight": 500.0},
      {"metric": "compression", "weight": 5.0},
      {"metric": "compute_cost", "weight": -0.3}
    ],
    "hardening": ["no_nan"]
  }
}
