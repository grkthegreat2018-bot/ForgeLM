{
  "name": "sparse_attn",
  "category": "misc",
  "description": "Sparse attention: strategy, budget_ratio, block_size, min_seq_len, k_ratio. Delegates to SparseAttentionDomain.",
  "simulator": "sparse_attn_simulate",
  "params": [
    {"name": "strategy", "type": "choice", "values": ["compact", "cosa", "mosa"]},
    {"name": "budget_ratio", "type": "float", "range": [0.1, 0.9]},
    {"name": "block_size", "type": "int", "range": [8, 32]},
    {"name": "min_seq_len", "type": "int", "range": [256, 1024]},
    {"name": "k_ratio", "type": "float", "range": [0.2, 0.8]}
  ],
  "behavioral_dims": [["compression", 10, 1.0, 10.0], ["fwd_error", 10, 0.0, 0.3]],
  "scoring": {
    "components": [
      {"metric": "base_score", "weight": 1.0}
    ],
    "hardening": ["no_nan"]
  }
}
